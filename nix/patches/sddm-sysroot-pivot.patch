+        qInfo("Pivoting into /sysroot");
+        chdir("/sysroot");
+        chroot(".");
+
+        QPlatformNativeInterface *nativeInterface = QGuiApplication::platformNativeInterface();
+        void *res = nativeInterface ? nativeInterface->nativeResourceForIntegration(QByteArrayLiteral("dri_fd")) : nullptr;
+        if (res) {
+            takeoverHandlerDriFd = (int)(qintptr) res;
+            signal(SIGSEGV, onFatalSignal);
