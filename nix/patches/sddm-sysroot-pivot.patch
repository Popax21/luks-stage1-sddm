+static void onFatalSignal(int sig)
+{
+    // Exit on a fatal memory access signal if our DRI device was lost
+    //  - Mesa handles this poorly and derefs NULL
+    if (ioctl(takeoverHandlerDriFd, 0) != 0 && errno == ENODEV) _exit(0);
+    signal(sig, SIG_DFL);
+}
